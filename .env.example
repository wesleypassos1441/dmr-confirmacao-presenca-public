# Dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DMR_BOT_TOKEN=cole_aqui_o_mesmo_token_configurado_no_supabase
DMR_ALLOWED_ORIGIN=http://localhost:3000

# WhatsApp bot local
EDGE_FUNCTIONS_BASE_URL=https://example-project-ref.functions.supabase.co
BOT_POLL_INTERVAL_MS=3000
BOT_HEARTBEAT_INTERVAL_MS=60000
BOT_HIGH_PRIORITY_MIN_SECONDS=6
BOT_HIGH_PRIORITY_MAX_SECONDS=15
BOT_NORMAL_PRIORITY_MIN_SECONDS=25
BOT_NORMAL_PRIORITY_MAX_SECONDS=45
BOT_SAFE_DEBUG=false
WHATSAPP_HEADLESS=true
WHATSAPP_AUTH_TIMEOUT_MS=90000
WHATSAPP_PROTOCOL_TIMEOUT_MS=180000
WHATSAPP_SEND_TIMEOUT_MS=120000
WHATSAPP_READY_GRACE_MS=15000
WHATSAPP_RUNTIME_PROBE_TIMEOUT_MS=10000
WHATSAPP_MAX_UPTIME_MINUTES=30
WHATSAPP_SESSION_ID=dmr-confirmacao-presenca
WHATSAPP_WINDOW_WIDTH=720
WHATSAPP_WINDOW_HEIGHT=720
WHATSAPP_WINDOW_X=40
WHATSAPP_WINDOW_Y=40
# User-Agent deve corresponder ao navegador detectado automaticamente.
# Se WHATSAPP_BROWSER_PATH aponta para o Edge (msedge.exe), use um UA com "Edg/".
# Se deixar em branco, o bot escolhe automaticamente com base no executavel detectado.
WHATSAPP_USER_AGENT=
WHATSAPP_PAIR_PHONE_NUMBER=55DDDNUMERO
WHATSAPP_PAIR_INTERVAL_MS=180000
WHATSAPP_BROWSER_PATH=

# Alertas externos do supervisor local
# Configure com scripts/telegram-setup.ps1. Nunca use prefixo NEXT_PUBLIC_.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=900
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY_MS=1000

# Watchdog independente do navegador. Verifica a cada 3 segundos e reinicia
# quando o bot fica 60 segundos sem renovar seu sinal de vida.
BOT_WATCHDOG_INTERVAL_SECONDS=3
BOT_WATCHDOG_STALE_SECONDS=60
BOT_WATCHDOG_STARTUP_GRACE_SECONDS=180

# Agenda automatica local do bot (nao sao segredos)
# BOT_SCHEDULE_START       - Hora de inicio do bot (HH:mm, seg-sex). Padrao: 05:50
# BOT_SCHEDULE_GUARDIAN_START - Hora em que o guardiao comeca a monitorar (HH:mm). Padrao: 16:00
# BOT_SCHEDULE_GUARDIAN_END   - Limite da janela; pode ser no dia seguinte (HH:mm). Padrao: 05:45
# BOT_SCHEDULE_POLL_SECONDS   - Intervalo de verificacao do guardiao em segundos. Padrao: 300
BOT_SCHEDULE_START=05:50
BOT_SCHEDULE_GUARDIAN_START=16:00
BOT_SCHEDULE_GUARDIAN_END=05:45
BOT_SCHEDULE_POLL_SECONDS=300
